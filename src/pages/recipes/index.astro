---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { createRecipeService } from "@/lib/services/recipe.service";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const warning = Astro.url.searchParams.get("warning");

const recipes = user && supabase ? await createRecipeService(supabase, user.id).listRecipes() : [];
---

<Layout title="Recipes">
  <div class="bg-cosmic min-h-screen px-4 py-6 text-white">
    <div class="mx-auto max-w-4xl">
      <Topbar />

      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm tracking-[0.3em] text-blue-200/60 uppercase">Cookbook</p>
          <h1 class="mt-2 text-3xl font-semibold text-white">Your recipes</h1>
          <p class="mt-2 max-w-2xl text-sm text-blue-100/65">
            Keep the recipes you actually cook close at hand, with just enough context to find them again fast.
          </p>
        </div>

        <a
          href="/recipes/new"
          class="inline-flex items-center rounded-lg border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
        >
          Add recipe
        </a>
      </div>

      {
        warning ? (
          <div class="mb-6 rounded-xl border border-amber-300/30 bg-amber-500/15 px-4 py-3 text-sm text-amber-100">
            {warning}
          </div>
        ) : null
      }

      {
        recipes.length > 0 ? (
          <div class="grid gap-4 md:grid-cols-2">
            {recipes.map((recipe) => (
              <article class="rounded-2xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
                <h2 class="text-xl font-semibold text-white">{recipe.title}</h2>
                <p class="mt-3 text-sm leading-6 text-blue-100/70">
                  {recipe.lead ?? "No lead yet. Open this recipe in the next slice to add more detail and context."}
                </p>
              </article>
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center backdrop-blur-sm">
            <h2 class="text-xl font-semibold text-white">No recipes yet</h2>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-blue-100/70">
              Start with one recipe you know well. Once it is here, the next slice will make it searchable by tags and
              ingredients.
            </p>
            <a
              href="/recipes/new"
              class="mt-6 inline-flex items-center rounded-lg border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20"
            >
              Add your first recipe
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>
