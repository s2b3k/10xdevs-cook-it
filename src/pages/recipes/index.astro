---
import Layout from "@/layouts/Layout.astro";
import RecipeWorkspace from "@/components/recipes/RecipeWorkspace.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { createRecipeService } from "@/lib/services/recipe.service";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const warning = Astro.url.searchParams.get("warning");

const recipes = user && supabase ? await createRecipeService(supabase, user.id).listRecipes() : [];
---

<Layout title="Recipes">
  <div class="bg-cosmic min-h-screen px-4 py-6 text-white">
    <div class="mx-auto max-w-4xl">
      <Topbar />
      <RecipeWorkspace recipes={recipes} warning={warning} />
    </div>
  </div>
</Layout>
