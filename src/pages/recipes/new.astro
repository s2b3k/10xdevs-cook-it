---
import AddRecipeForm from "@/components/recipes/AddRecipeForm";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Nowy przepis">
  <div class="bg-cosmic min-h-screen px-4 py-6 text-white">
    <div class="mx-auto max-w-3xl">
      <Topbar />

      <div class="rounded-3xl border border-white/10 bg-white/8 p-6 shadow-2xl backdrop-blur-sm md:p-8">
        <p class="text-sm tracking-[0.3em] text-blue-200/60 uppercase">New recipe</p>
        <h1 class="mt-2 text-3xl font-semibold text-white">Add a recipe you want to cook again</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/65">
          Save the essentials now. You will use tags and ingredients in the next slice to search this list quickly.
        </p>

        <div class="mt-8">
          <AddRecipeForm client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
