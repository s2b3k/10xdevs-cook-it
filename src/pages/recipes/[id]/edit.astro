---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EditRecipeForm from "@/components/recipes/EditRecipeForm";
import { createClient } from "@/lib/supabase";
import { createRecipeService } from "@/lib/services/recipe.service";
import { RECIPE_ERROR_CODES, RecipeDomainError } from "@/lib/services/recipe.errors";
import type { Recipe, Taxonomy } from "@/types";
import { z } from "zod";

const { user } = Astro.locals;
const recipeId = Astro.params.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const service = user && supabase ? createRecipeService(supabase, user.id) : null;

let recipe: Recipe | null = null;
let taxonomies: Taxonomy[] = [];
let errorMessage: string | null = null;
let notFound = false;

if (!recipeId || !service || !z.uuid().safeParse(recipeId).success) {
  notFound = true;
} else {
  try {
    recipe = await service.getRecipe(recipeId);
    taxonomies = await service.listTaxonomiesForRecipe(recipeId);
  } catch (error) {
    if (error instanceof RecipeDomainError && error.code === RECIPE_ERROR_CODES.notFound) {
      notFound = true;
    } else {
      errorMessage = error instanceof Error ? error.message : "Failed to load recipe.";
    }
  }
}
---

<Layout title={recipe ? `Edit ${recipe.title}` : "Edit recipe"}>
  <div class="bg-cosmic min-h-screen px-4 py-6 text-white">
    <div class="mx-auto max-w-3xl">
      <Topbar />

      {
        notFound ? (
          <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center">
            <h1 class="text-2xl font-semibold">Recipe not found</h1>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-blue-100/70">
              This recipe does not exist or is not available in your cookbook.
            </p>
          </div>
        ) : errorMessage ? (
          <div class="rounded-2xl border border-red-300/20 bg-red-500/10 p-8 text-center text-red-100">
            <h1 class="text-2xl font-semibold">Recipe unavailable</h1>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6">{errorMessage}</p>
          </div>
        ) : recipe ? (
          <div class="rounded-3xl border border-white/10 bg-white/8 p-6 shadow-2xl backdrop-blur-sm md:p-8">
            <a
              href={`/recipes/${recipe.id}`}
              class="text-sm text-blue-100/60 transition-colors hover:text-white hover:underline"
            >
              Back to recipe
            </a>
            <p class="mt-8 text-sm tracking-[0.3em] text-blue-200/60 uppercase">Edit recipe</p>
            <h1 class="mt-2 text-3xl font-semibold text-white">Keep this one worth cooking again</h1>
            <div class="mt-8">
              <EditRecipeForm client:load recipe={recipe} taxonomies={taxonomies} />
            </div>
          </div>
        ) : null
      }
    </div>
  </div>
</Layout>
