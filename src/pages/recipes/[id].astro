---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import RecipeActions from "@/components/recipes/RecipeActions";
import { createClient } from "@/lib/supabase";
import { createRecipeService } from "@/lib/services/recipe.service";
import { RECIPE_ERROR_CODES, RecipeDomainError } from "@/lib/services/recipe.errors";
import type { Recipe, Taxonomy } from "@/types";
import { z } from "zod";

const { user } = Astro.locals;
const recipeId = Astro.params.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const service = user && supabase ? createRecipeService(supabase, user.id) : null;

let recipe: Recipe | null = null;
let taxonomies: Taxonomy[] = [];
let errorMessage: string | null = null;
let notFound = false;

if (!recipeId || !service || !z.uuid().safeParse(recipeId).success) {
  notFound = true;
} else {
  try {
    recipe = await service.getRecipe(recipeId);
    taxonomies = await service.listTaxonomiesForRecipe(recipeId);
  } catch (error) {
    if (error instanceof RecipeDomainError && error.code === RECIPE_ERROR_CODES.notFound) {
      notFound = true;
    } else {
      errorMessage = error instanceof Error ? error.message : "Failed to load recipe.";
    }
  }
}
---

<Layout title={recipe?.title ?? "Recipe not found"}>
  <div class="bg-cosmic min-h-screen px-4 py-6 text-white">
    <div class="mx-auto max-w-4xl">
      <Topbar />

      <a href="/recipes" class="mb-8 inline-flex text-sm text-blue-200/70 transition-colors hover:text-white">
        Back to recipes
      </a>

      <div class:list={["mb-6", !recipe && "hidden"]}>
        <RecipeActions client:load recipeId={recipeId ?? ""} />
      </div>

      {
        notFound ? (
          <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center">
            <h1 class="text-2xl font-semibold">Recipe not found</h1>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-blue-100/70">
              This recipe does not exist or is not available in your cookbook.
            </p>
          </div>
        ) : errorMessage ? (
          <div class="rounded-2xl border border-red-300/20 bg-red-500/10 p-8 text-center text-red-100">
            <h1 class="text-2xl font-semibold">Recipe unavailable</h1>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6">{errorMessage}</p>
          </div>
        ) : recipe ? (
          <article class="space-y-8">
            <header class="border-b border-white/10 pb-8">
              <p class="text-sm tracking-[0.3em] text-blue-200/60 uppercase">Recipe</p>
              <h1 class="mt-3 text-4xl font-semibold text-white">{recipe.title}</h1>
              {recipe.lead ? <p class="mt-4 max-w-2xl text-lg leading-8 text-blue-100/70">{recipe.lead}</p> : null}
              {taxonomies.length > 0 ? (
                <div class="mt-5 flex flex-wrap gap-2">
                  {taxonomies.map((taxonomy) => (
                    <span class="rounded-full border border-blue-200/20 bg-blue-200/10 px-3 py-1 text-sm text-blue-100">
                      {taxonomy.name}
                    </span>
                  ))}
                </div>
              ) : null}
            </header>

            {recipe.photoUrl ? (
              <img src={recipe.photoUrl} alt="" class="max-h-[30rem] w-full rounded-2xl object-cover" />
            ) : null}

            <div class="grid gap-8 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
              <section>
                <h2 class="text-xl font-semibold">Ingredients</h2>
                <p class="mt-4 text-sm leading-7 whitespace-pre-line text-blue-100/75">{recipe.ingredients}</p>
              </section>
              <section>
                <h2 class="text-xl font-semibold">Instructions</h2>
                <p class="mt-4 text-sm leading-7 whitespace-pre-line text-blue-100/75">{recipe.instructions}</p>
              </section>
            </div>
          </article>
        ) : null
      }
    </div>
  </div>
</Layout>
