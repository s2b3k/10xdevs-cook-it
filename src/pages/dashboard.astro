---
import Layout from "@/layouts/Layout.astro";
import { createStatsService } from "@/lib/services/stats.service";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const stats = user ? await createStatsService(supabase, user.id).getUserStats() : { recipeCount: 0, taxonomyCount: 0 };
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>

      <div class="mt-6 grid grid-cols-2 gap-4">
        <div
          class="rounded-xl border border-white/10 bg-white/5 p-4 transition-colors hover:border-white/20 hover:bg-white/10"
        >
          <div class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            {stats.recipeCount}
          </div>
          <div class="mt-1 text-xs font-medium tracking-wider text-blue-100/70 uppercase">Recipes</div>
        </div>

        <div
          class="rounded-xl border border-white/10 bg-white/5 p-4 transition-colors hover:border-white/20 hover:bg-white/10"
        >
          <div class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            {stats.taxonomyCount}
          </div>
          <div class="mt-1 text-xs font-medium tracking-wider text-blue-100/70 uppercase">Tags Used</div>
        </div>
      </div>

      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
