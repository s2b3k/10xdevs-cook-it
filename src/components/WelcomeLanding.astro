---
import RecipeWorkspace from "@/components/recipes/RecipeWorkspace.astro";
import Topbar from "@/components/Topbar.astro";
import type { User } from "@supabase/supabase-js";
import type { Recipe } from "@/types";

interface Props {
  user: User | null;
  recipes: Recipe[];
  warning?: string | null;
}

const { user, recipes, warning } = Astro.props;
---

<div class="bg-cosmic w-full text-white">
  <section class="welcome-section relative min-h-screen w-full overflow-clip lg:h-[1500px] lg:min-h-0">
    <div class="star-field pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="star-layer star-layer-far"></div>
      <div class="star-layer star-layer-mid"></div>
      <div class="star-layer star-layer-near"></div>
    </div>

    <div class="relative z-10 p-4 sm:p-8 lg:sticky lg:top-0">
      <Topbar />
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
        <h1
          class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
        >
          cook.it
        </h1>
        <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
          Find the recipes you love, keep them close, and decide what to cook next without digging through scattered
          notes.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="/auth/signin"
            class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
            >Sign in</a
          >
          <a
            href="/auth/signup"
            class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
            >Sign up</a
          >
        </div>
      </div>
      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Keep your favourites close</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Build a personal cookbook from the recipes you actually want to make again.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Find dinner faster</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Search by ingredient and taxonomy when the question is simply: what can I cook?
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Plan a few good meals</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Turn a scattered collection of recipes into a calmer starting point for the week.
          </p>
        </div>
      </div>
      <div class="scroll-cue flex justify-center pb-8 text-yellow-200/70" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14"></path>
          <path d="m19 12-7 7-7-7"></path>
        </svg>
      </div>
    </div>
  </section>

  {
    user ? (
      <section id="recipe-workspace" class="recipe-workspace bg-cosmic px-4 py-16 text-white sm:px-8 lg:min-h-[1300px]">
        <div class="relative z-10 mx-auto max-w-4xl">
          <RecipeWorkspace recipes={recipes} warning={warning} />
        </div>
      </section>
    ) : null
  }

  {!user ? <div class="bg-cosmic h-16" aria-hidden="true" /> : null}

  <style>
    .recipe-workspace {
      --recipe-halo-progress: 0;
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .scroll-cue {
      animation: scroll-cue-drift 2.8s ease-in-out infinite;
    }
    @keyframes scroll-cue-drift {
      0%,
      100% {
        transform: translateY(0);
        opacity: 0.55;
      }
      50% {
        transform: translateY(0.4rem);
        opacity: 0.95;
      }
    }
    .recipe-workspace::before {
      position: absolute;
      z-index: 0;
      top: -4rem;
      left: 50%;
      width: min(46rem, 100%);
      height: 15rem;
      border-radius: 50%;
      background: radial-gradient(
        ellipse at center top,
        rgb(250 204 21 / calc(var(--recipe-halo-progress) * 0.72)),
        rgb(245 158 11 / calc(var(--recipe-halo-progress) * 0.28)) 28%,
        transparent 72%
      );
      filter: blur(22px);
      opacity: var(--recipe-halo-progress);
      transform: translateX(-50%);
      transition: opacity 120ms linear;
      content: "";
      pointer-events: none;
    }
    .recipe-workspace::after {
      position: absolute;
      z-index: 1;
      top: 0;
      right: 0;
      left: 0;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgb(250 204 21 / 25%) 28%,
        rgb(253 224 71 / 75%) 50%,
        rgb(245 158 11 / 25%) 72%,
        transparent 100%
      );
      background-size: 220% 100%;
      animation: recipe-edge-sheen 12s ease-in-out infinite;
      content: "";
      pointer-events: none;
    }
    @keyframes recipe-edge-sheen {
      0%,
      22% {
        background-position: 120% 0;
      }
      52%,
      74% {
        background-position: -20% 0;
      }
      100% {
        background-position: 120% 0;
      }
    }
    .star-layer {
      position: absolute;
      inset: -10% 0;
      transform: translate3d(0, 0, 0);
    }
    @supports (animation-timeline: scroll()) {
      .star-layer {
        animation: star-field-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0% 100%;
      }
      .star-layer-mid {
        animation-name: star-field-drift-mid;
      }
      .star-layer-near {
        animation-name: star-field-drift-near;
      }
    }
    @keyframes star-field-drift {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 120px, 0);
      }
    }
    @keyframes star-field-drift-mid {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 80px, 0);
      }
    }
    @keyframes star-field-drift-near {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 45px, 0);
      }
    }
    .star-layer-far {
      background-image: radial-gradient(circle, var(--cosmic-star-far) 1px, transparent 1px);
      background-size: 200px 200px;
      background-position: 0 0;
    }
    .star-layer-mid {
      background-image: radial-gradient(circle, var(--cosmic-star-mid) 1px, transparent 1px);
      background-size: 150px 150px;
      background-position: 40px 60px;
    }
    .star-layer-near {
      background-image: radial-gradient(circle, var(--cosmic-star-near) 1px, transparent 1px);
      background-size: 100px 100px;
      background-position: 80px 30px;
    }
    @media (max-width: 1023px) {
      .star-layer {
        inset: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .star-layer {
        animation: none;
        transform: none;
      }
      .recipe-workspace::before {
        display: none;
      }
      .recipe-workspace::after {
        animation: none;
      }
      .scroll-cue {
        animation: none;
      }
    }
  </style>

  <script>
    const RECIPE_HANDOFF_ROOT_MARGIN_PERCENT = -95;
    const RECIPE_HANDOFF_APPROACH_LEAD = 0.3;
    const recipeWorkspace = document.querySelector("#recipe-workspace");
    const handoffTriggerViewportRatio = 1 + RECIPE_HANDOFF_ROOT_MARGIN_PERCENT / 100;
    const handoffRootMargin = `0px 0px ${RECIPE_HANDOFF_ROOT_MARGIN_PERCENT}% 0px`;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (recipeWorkspace && "IntersectionObserver" in window) {
      let hasNavigated = false;
      let frameRequest = 0;

      const updateHalo = () => {
        frameRequest = 0;
        if (hasNavigated || reducedMotion.matches) {
          return;
        }

        const viewportHeight = window.innerHeight;
        const triggerTop = viewportHeight * handoffTriggerViewportRatio;
        const approachStart = viewportHeight * (1 + RECIPE_HANDOFF_APPROACH_LEAD);
        const progress = Math.min(
          1,
          Math.max(0, (approachStart - recipeWorkspace.getBoundingClientRect().top) / (approachStart - triggerTop)),
        );
        recipeWorkspace.style.setProperty("--recipe-halo-progress", progress.toFixed(3));
      };

      const requestHaloUpdate = () => {
        if (!frameRequest) {
          frameRequest = window.requestAnimationFrame(updateHalo);
        }
      };

      window.addEventListener("scroll", requestHaloUpdate, { passive: true });
      window.addEventListener("resize", requestHaloUpdate, { passive: true });
      updateHalo();

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting || hasNavigated) {
            return;
          }

          hasNavigated = true;
          observer.disconnect();
          window.removeEventListener("scroll", requestHaloUpdate);
          window.removeEventListener("resize", requestHaloUpdate);
          window.location.assign("/recipes");
        },
        { rootMargin: handoffRootMargin, threshold: 0 },
      );

      observer.observe(recipeWorkspace);
    }
  </script>
</div>
