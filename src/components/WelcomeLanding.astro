---
import RecipeWorkspace from "@/components/recipes/RecipeWorkspace.astro";
import Topbar from "@/components/Topbar.astro";
import type { User } from "@supabase/supabase-js";
import type { Recipe } from "@/types";

interface Props {
  user: User | null;
  recipes: Recipe[];
  warning?: string | null;
}

const { user, recipes, warning } = Astro.props;
---

<div class="bg-cosmic w-full text-white">
  <section class="welcome-section relative min-h-screen w-full overflow-clip lg:h-[1500px] lg:min-h-0">
    <div class="star-field pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="star-layer star-layer-far"></div>
      <div class="star-layer star-layer-mid"></div>
      <div class="star-layer star-layer-near"></div>
    </div>

    <div class="relative z-10 p-4 sm:p-8 lg:sticky lg:top-0">
      <Topbar />
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
        <h1
          class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
        >
          cook.it
        </h1>
        <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">
          Find the recipes you love, keep them close, and decide what to cook next without digging through scattered
          notes.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="/auth/signin"
            class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
            >Sign in</a
          >
          <a
            href="/auth/signup"
            class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
            >Sign up</a
          >
        </div>
      </div>
      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Keep your favourites close</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Build a personal cookbook from the recipes you actually want to make again.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Find dinner faster</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Search by ingredient and taxonomy when the question is simply: what can I cook?
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <h3 class="mb-2 text-lg font-semibold text-white">Plan a few good meals</h3><p
            class="text-sm leading-relaxed text-blue-100/60"
          >
            Turn a scattered collection of recipes into a calmer starting point for the week.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    user ? (
      <section id="recipe-workspace" class="bg-cosmic px-4 py-16 text-white sm:px-8">
        <div class="mx-auto max-w-4xl">
          <RecipeWorkspace recipes={recipes} warning={warning} />
        </div>
      </section>
    ) : null
  }

  {!user ? <div class="bg-cosmic h-16" aria-hidden="true" /> : null}

  <style>
    .star-layer {
      position: absolute;
      inset: -10% 0;
      transform: translate3d(0, 0, 0);
    }
    @supports (animation-timeline: scroll()) {
      .star-layer {
        animation: star-field-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0% 100%;
      }
      .star-layer-mid {
        animation-name: star-field-drift-mid;
      }
      .star-layer-near {
        animation-name: star-field-drift-near;
      }
    }
    @keyframes star-field-drift {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 120px, 0);
      }
    }
    @keyframes star-field-drift-mid {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 80px, 0);
      }
    }
    @keyframes star-field-drift-near {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(0, 45px, 0);
      }
    }
    .star-layer-far {
      background-image: radial-gradient(circle, var(--cosmic-star-far) 1px, transparent 1px);
      background-size: 200px 200px;
      background-position: 0 0;
    }
    .star-layer-mid {
      background-image: radial-gradient(circle, var(--cosmic-star-mid) 1px, transparent 1px);
      background-size: 150px 150px;
      background-position: 40px 60px;
    }
    .star-layer-near {
      background-image: radial-gradient(circle, var(--cosmic-star-near) 1px, transparent 1px);
      background-size: 100px 100px;
      background-position: 80px 30px;
    }
    @media (max-width: 1023px) {
      .star-layer {
        inset: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .star-layer {
        animation: none;
        transform: none;
      }
    }
  </style>

  <script>
    const RECIPE_HANDOFF_THRESHOLD = 0.6;
    const recipeWorkspace = document.querySelector("#recipe-workspace");
    const handoffRootMargin = `0px 0px -${(1 - RECIPE_HANDOFF_THRESHOLD) * 100}% 0px`;

    if (recipeWorkspace && "IntersectionObserver" in window) {
      let hasNavigated = false;
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting || hasNavigated) {
            return;
          }

          hasNavigated = true;
          observer.disconnect();
          window.location.assign("/recipes");
        },
        { rootMargin: handoffRootMargin, threshold: 0 },
      );

      observer.observe(recipeWorkspace);
    }
  </script>
</div>
